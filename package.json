{
  "name": "electronics-in-20",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Electronics in 20%: an interactive 3D course for busy adult beginners",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "verify": "node scripts/verify.ts",
    "typecheck": "tsc --noEmit",
    "test:solver": "node scripts/solver-test.ts",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run test:solver && npm run verify",
    "docs": "node scripts/export-course.ts"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.170.0",
    "playwright-core": "^1.49.1",
    "typescript": "5.7.2",
    "vite": "6.4.5"
  }
}